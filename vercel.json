{
  "outputDirectory": "Frontend",
  "routes": [
    {
      "src": "/product.html",
      "has": [
        { "type": "header", "key": "user-agent", "value": ".*(facebookexternalhit|facebot|Messenger|Zalo|Twitterbot|TelegramBot|Slackbot|LinkedInBot|WhatsApp|Discordbot|Viber|Pinterest|Googlebot|bingbot).*" },
        { "type": "query", "key": "id" }
      ],
      "dest": "/api/product-og"
    },
    { "handle": "filesystem" }
  ]
}
