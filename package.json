{
  "name": "tien-mobile-web",
  "version": "1.0.0",
  "description": "Tien Mobile Thu Duc - Apple (Việt Nam) Inspired Retail & Repair Website",
  "main": "Frontend/js/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test Tests/**/*.test.js",
    "test:unit": "node --test Tests/unit/*.test.js",
    "test:integration": "node --test Tests/integration/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test-coverage-include='Frontend/js/{store,searchMatch,utils,templates,productsApi,ordersApi,warranty,warrantyApi,tradeIn,installment,installmentApi,zalo,customSelect,config,waterRipples,lazyScripts}.js' --test-coverage-include='api/_og.js' --test-coverage-include='Frontend/admin/{adminHelpers,ordersHelpers,invoiceHelpers,cashflowHelpers,sheetPricing,modelImages,bulkSelect,pricing,accessorySheet,syncPlan,imageLibrary,buybackContract}.js' Tests/unit/*.test.js Tests/integration/*.test.js",
    "build:css": "tailwindcss -c tailwind.config.cjs -i Frontend/css/tailwind.src.css -o Frontend/css/tailwind.css --minify",
    "build:stamp": "node tools/stamp-modules.mjs"
  },
  "keywords": [
    "apple",
    "retail",
    "mobile",
    "repair",
    "tdd",
    "store"
  ],
  "author": "Tien Mobile Thu Duc",
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "tailwindcss": "^3.4.17"
  }
}
