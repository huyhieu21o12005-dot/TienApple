{
  "name": "tien-mobile-web",
  "version": "1.0.0",
  "description": "Tien Mobile Thu Duc - Apple (Việt Nam) Inspired Retail & Repair Website",
  "main": "Frontend/js/app.js",
  "type": "module",
  "scripts": {
    "test": "node --test Tests/**/*.test.js",
    "test:unit": "node --test Tests/unit/*.test.js",
    "test:integration": "node --test Tests/integration/*.test.js",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include='Frontend/js/{store,utils,templates,productsApi,ordersApi,warranty,warrantyApi,tradeIn,installment,installmentApi,zalo,customSelect,config,waterRipples}.js' --test-coverage-include='Frontend/admin/{adminHelpers,ordersHelpers,invoiceHelpers,cashflowHelpers,sheetPricing,modelImages,bulkSelect,pricing}.js' Tests/unit/*.test.js Tests/integration/*.test.js"
  },
  "keywords": [
    "apple",
    "retail",
    "mobile",
    "repair",
    "tdd",
    "store"
  ],
  "author": "Tien Mobile Thu Duc",
  "license": "MIT"
}
